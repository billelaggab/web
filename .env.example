# ==================================================================
#  متغيرات البيئة — انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل.
#  النظام يعمل معزولاً تماماً: لا حاجة لأي مفتاح خدمة خارجية.
# ==================================================================

# ---- PostgreSQL ----
POSTGRES_USER=icims
POSTGRES_PASSWORD=icims_local_pw
POSTGRES_DB=icims

# ---- سرية التطبيق (توقيع رموز تنزيل الوسائط HMAC-SHA256) ----
# أنشئ سراً قوياً:  openssl rand -hex 32
APP_SECRET=change-me-app-secret

# ---- Meilisearch ----
MEILI_MASTER_KEY=change-me-local-master-key

# ---- الوكيل المكشوف ----
# 127.0.0.1 للوصول المحلي فقط، أو 0.0.0.0 للسماح لعناوين الشبكة المحلية.
BIND_ADDR=127.0.0.1
BIND_PORT=8080

# ---- تشغيل محلي بدون Docker (npm run dev / npm start) ----
DATABASE_URL=postgresql://icims:icims_local_pw@127.0.0.1:5432/icims
MEDIA_DIR=./.data/uploads
# اتركه فارغاً لاستخدام فهرس PostgreSQL المحلي (تطبيع عربي + مطابقة ضبابية)
MEILISEARCH_HOST=
